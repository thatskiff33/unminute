<?xml version="1.0" encoding="utf-8"?>
<!-- English text for Unminute.admx (#111 slice A5). -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Unminute</displayName>
  <description>Managed settings for Unminute, the local meeting transcription app.</description>
  <resources>
    <stringTable>
      <string id="Unminute">Unminute</string>
      <string id="SUPPORTED_Unminute">Unminute releases after 0.4.3, on Windows 10 or 11</string>

      <string id="AllowModelDownloads">Allow model downloads in the app</string>
      <string id="AllowModelDownloads_Help">Enabled or not configured: users can download and repair speech and speaker models in Setup and Downloads.

Disabled: the app refuses downloads and shows "Ask your IT team". Use this when IT installs the models, so the app never needs the network (a models package for Intune is planned).</string>

      <string id="AllowGpuComponent">Allow the graphics card component</string>
      <string id="AllowGpuComponent_Help">Enabled or not configured: on computers with a supported NVIDIA card, users can download the graphics card component (about 1.9 GB of PyTorch and CUDA libraries into their profile) and use it for speaker identification.

Disabled: the component cannot be downloaded or used; speaker identification runs on the processor.</string>

      <string id="AllowMicrophoneRecording">Allow microphone recording</string>
      <string id="AllowMicrophoneRecording_Help">Enabled or not configured: users can turn on microphone recording in Settings.

Disabled: microphone recording is off and cannot be turned on, and a recording in progress is stopped and saved when the app next reads the policy (within 15 minutes). Recordings can still be imported.</string>

      <string id="AllowWatchedFolders">Allow watched folders</string>
      <string id="AllowWatchedFolders_Help">Enabled or not configured: users can choose folders that the app checks for new recordings.

Disabled: no new watched folders can be added and existing ones are not checked.</string>

      <string id="AllowDeleteOriginals">Allow deleting original recordings from watched folders</string>
      <string id="AllowDeleteOriginals_Help">Enabled or not configured: for a watched folder, a user may allow the app to delete an original recording after its transcript is reviewed (only if it is exactly the file that was imported).

Disabled: that permission cannot be given, and originals are never deleted, including for folders where it was given before. A deletion in a synced folder (OneDrive, SharePoint) also deletes the file for everyone the folder is shared with.</string>

      <string id="AllowNetworkSources">Allow recordings on network drives</string>
      <string id="AllowNetworkSources_Help">Disabled or not configured: recordings on mapped network drives, or reached through a symbolic link, are refused; users copy them to the computer first. Synced folders such as OneDrive are not affected.

Enabled: such recordings can be imported with Import or by dragging them onto the window. Opening them connects to the file server with the user's Windows credentials. Users open them through the mapped drive letter; a \\server\share path chosen directly is still refused. Watched folders must still be on the computer.</string>

      <string id="HandoffFilenameIncludesTitle">Suggest the meeting title as the handoff file name</string>
      <string id="HandoffFilenameIncludesTitle_Help">Disabled or not configured: Save suggests "Meeting transcript" with the date and time, because meeting titles often name the client and file names are recorded in many places (recent items, search indexes, sync logs).

Enabled: Save suggests the meeting title, except when speaker names are being replaced.</string>

      <string id="ClipboardClearMinutes">Clear the app's handoff copy from the clipboard</string>
      <string id="ClipboardClearMinutes_Help">Enabled: a handoff copied with the app's Copy button is removed from the clipboard after this many minutes (1 to 1440), and when the app closes, unless something else was copied in the meantime. Time the computer spends asleep counts.

Disabled, not configured or 0: the app never clears the clipboard.</string>

      <string id="HandoffDefaultFolder">Starting folder for saved handoffs</string>
      <string id="HandoffDefaultFolder_Help">Enabled: the handoff Save dialog starts in this folder, for example a client files location. Use a full path that starts with a drive letter; a mapped drive is fine, but \\server\share paths are not accepted. Environment variables such as %USERPROFILE% are expanded. Users can still choose another folder.

Not configured, or a folder that does not exist: the dialog starts in its usual place.</string>
    </stringTable>
    <presentationTable>
      <presentation id="ClipboardClearMinutes">
        <decimalTextBox refId="ClipboardClearMinutes" defaultValue="10">Minutes</decimalTextBox>
      </presentation>
      <presentation id="HandoffDefaultFolder">
        <textBox refId="HandoffDefaultFolder">
          <label>Folder</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
