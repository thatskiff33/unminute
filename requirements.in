# Unminute's direct runtime dependencies, for Windows x64 and CPython 3.14.
# requirements.txt is generated from this file by tools/lock.py and pins every
# package, direct or not, with its SHA-256 hashes. Edit this file, then run
#   python tools/lock.py
# and commit both. Change dependencies only as a compatible set with Windows
# wheels (AGENTS.md, "Checks"), and adopt a new version only after it has been
# public for at least 7 days.

# Speech recognition. onnx-asr is installed without extras: onnxruntime is
# pinned here and shared with faster-whisper's voice detection. onnx-asr's [cpu]
# extra excludes onnxruntime 1.24.1, 1.25.* and 1.26.0, so stay off those.
faster-whisper==1.2.1
onnx-asr==0.12.0
onnxruntime==1.30.0

# Speaker identification (torch, torchaudio, torchcodec and pyannote.audio move
# together). torch 2.14.1: the PyTorch index publishes a SHA-256 for its CUDA
# wheel for CPython 3.14 on Windows (workspace/gpu.py); for 2.13.0 it publishes
# none. torchcodec 0.12 and later work with torch 2.11 and later, and torchaudio
# 2.11 does not pin torch.
pyannote-audio==4.0.4
torch==2.14.1
torchaudio==2.11.0
torchcodec==0.14.0
# Security floor for a dependency of pyannote.audio (CVE-2026-58659, #118).
pytorch-lightning>=2.6.6

# Media, audio and arrays
av==17.1.0
numpy==2.4.6
sounddevice==0.5.6

# Model downloads (the separate download process)
huggingface_hub==1.18.0
truststore==0.10.4

# The window. proxy_tools, which pywebview needs, has no published wheel: its
# pinned wheel is in packaging/wheels (tools/lock.py and the build find it there).
pywebview==6.2.1
